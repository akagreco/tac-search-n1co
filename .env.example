# TAC Search funciona sin claves mediante Wikimedia Commons, Openverse y modo mock.
MOCK_MODE=auto
NEXT_PUBLIC_MOCK_MODE=auto

# Buscadores web amplios (recomendado configurar al menos uno)
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=

# Archivos y bancos fotográficos
FLICKR_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# Localización y control de fuentes
SEARCH_COUNTRY=AR
SEARCH_LANGUAGE=es
WEB_RESULTS_PER_PROVIDER=100
DISABLED_PROVIDERS=
USE_SYSTEM_CA=true

# Persistencia y caché
DATABASE_URL="file:./dev.db"
REDIS_URL=
SEARCH_CACHE_TTL_SECONDS=900
RATE_LIMIT_PER_MINUTE=30

# Análisis remoto opcional (dHash + heurísticas visuales). Desactivado por defecto.
ENABLE_REMOTE_IMAGE_ANALYSIS=false
IMAGE_ANALYSIS_MAX_RESULTS=12

# Pesos configurables de broadcastScore (se normalizan automáticamente)
RANK_RELEVANCE_WEIGHT=0.24
RANK_QUALITY_WEIGHT=0.18
RANK_VISIBILITY_WEIGHT=0.14
RANK_PROFESSIONAL_WEIGHT=0.12
RANK_COMPOSITION_WEIGHT=0.10
RANK_CLEAN_WEIGHT=0.08
RANK_WATERMARK_WEIGHT=0.07
RANK_RECENCY_WEIGHT=0.07
